<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[Seu Nome] — Dev Back-end Trainee</title>
<style>
  :root{
    --fundo: #0a0e0a;
    --fundo-card: #10160f;
    --verde: #00ff66;
    --verde-escuro: #0a3d1f;
    --texto: #e6f5e9;
    --texto-suave: #9db8a3;
    --borda: #1e2b1e;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  body{
    background: var(--fundo);
    color: var(--texto);
    font-family: 'Courier New', monospace;
    line-height: 1.6;
  }

  h1,h2,h3{ font-family: 'Courier New', monospace; }

  img{ max-width:100%; display:block; }

  .container{
    width:100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 2rem);
  }

  /* ===== CABEÇALHO ===== */
  .cabecalho{
    position: sticky;
    top:0;
    background: rgba(10,14,10,0.95);
    border-bottom: 1px solid var(--borda);
    z-index: 10;
  }

  .cabecalho-conteudo{
    display:flex;
    justify-content: space-between;
    align-items:center;
    padding: 1rem clamp(1rem, 5vw, 2rem);
  }

  .logo{
    color: var(--verde);
    font-weight:bold;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
  }

  .botao-menu{
    background:none;
    border: 1px solid var(--verde);
    color: var(--verde);
    padding: 0.4rem 0.7rem;
    cursor:pointer;
    display:block;
  }

  .menu-nav{
    display:none;
    flex-direction:column;
    background: var(--fundo);
    border-top: 1px solid var(--borda);
  }

  .menu-nav.aberto{ display:flex; }

  .menu-nav a{
    color: var(--texto);
    text-decoration:none;
    padding: 0.9rem 1.2rem;
    border-bottom: 1px solid var(--borda);
  }

  .menu-nav a:hover{ color: var(--verde); }

  /* ===== HERO ===== */
  .heroi{
    padding: clamp(3rem, 8vw, 6rem) 0;
    text-align:center;
  }

  .heroi-foto{
    width: clamp(120px, 30vw, 180px);
    height: clamp(120px, 30vw, 180px);
    border-radius:50%;
    border: 2px solid var(--verde);
    object-fit:cover;
    margin: 0 auto 1.5rem;
  }

  .heroi-titulo{
    font-size: clamp(1.6rem, 5vw, 2.8rem);
    color: var(--verde);
    margin-bottom: 0.5rem;
  }

  .heroi-subtitulo{
    color: var(--texto-suave);
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    margin-bottom: 1.5rem;
  }

  .heroi-bio{
    max-width: 560px;
    margin: 0 auto 2rem;
    color: var(--texto);
    font-size: clamp(0.9rem, 2vw, 1rem);
  }

  .botao-cta{
    display:inline-block;
    background: var(--verde);
    color: var(--fundo);
    padding: 0.8rem 1.8rem;
    text-decoration:none;
    font-weight:bold;
    border-radius: 4px;
  }

  /* ===== SEÇÕES GERAIS ===== */
  section{ padding: clamp(2.5rem, 6vw, 4rem) 0; }

  .titulo-secao{
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: var(--verde);
    margin-bottom: 2rem;
    text-align:center;
  }

  /* ===== PORTFÓLIO ===== */
  .grade-portfolio{
    display:grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .cartao-projeto{
    background: var(--fundo-card);
    border: 1px solid var(--borda);
    border-radius: 8px;
    overflow:hidden;
  }

  .cartao-projeto img{ aspect-ratio: 16/10; object-fit:cover; }

  .cartao-projeto-conteudo{ padding: 1.2rem; }

  .cartao-projeto h3{ color: var(--verde); margin-bottom: 0.5rem; font-size: 1.1rem; }

  .cartao-projeto p{ color: var(--texto-suave); font-size: 0.9rem; margin-bottom: 0.8rem; }

  .cartao-projeto a{ color: var(--verde); font-size: 0.85rem; }

  /* ===== SERVIÇOS / SKILLS ===== */
  .grade-skills{
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .item-skill{
    background: var(--fundo-card);
    border: 1px solid var(--borda);
    border-radius: 6px;
    padding: 1.2rem;
    text-align:center;
  }

  .item-skill span{
    display:block;
    color: var(--verde);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .item-skill p{ font-size: 0.85rem; color: var(--texto-suave); }

  /* ===== PROVA SOCIAL ===== */
  .grade-metricas{
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    text-align:center;
  }

  .metrica-numero{
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--verde);
    font-weight:bold;
  }

  .metrica-label{ color: var(--texto-suave); font-size: 0.85rem; }

  .depoimento{
    background: var(--fundo-card);
    border-left: 3px solid var(--verde);
    padding: 1.2rem;
    margin-top: 1.5rem;
    font-style: italic;
    color: var(--texto-suave);
  }

  /* ===== CONTATO ===== */
  .formulario-contato{
    display:flex;
    flex-direction:column;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .formulario-contato input,
  .formulario-contato textarea{
    background: var(--fundo-card);
    border: 1px solid var(--borda);
    color: var(--texto);
    padding: 0.8rem;
    font-family: inherit;
    border-radius: 4px;
  }

  .formulario-contato button{
    background: var(--verde);
    color: var(--fundo);
    border:none;
    padding: 0.9rem;
    font-weight:bold;
    cursor:pointer;
    border-radius: 4px;
  }

  .redes-sociais{
    display:flex;
    justify-content:center;
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .redes-sociais a{ color: var(--verde); text-decoration:none; font-size: 0.9rem; }

  /* ===== RODAPÉ ===== */
  .rodape{
    text-align:center;
    padding: 1.5rem;
    border-top: 1px solid var(--borda);
    color: var(--texto-suave);
    font-size: 0.8rem;
  }

  /* ===== MOBILE FIRST: BREAKPOINTS ===== */
  @media (min-width: 700px){
    .botao-menu{ display:none; }

    .menu-nav{
      display:flex !important;
      flex-direction:row;
      background:none;
      border:none;
    }

    .menu-nav a{ border:none; padding: 0.5rem 1rem; }

    .grade-portfolio{ grid-template-columns: repeat(2, 1fr); }

    .grade-skills{ grid-template-columns: repeat(4, 1fr); }

    .grade-metricas{ grid-template-columns: repeat(4, 1fr); }
  }

  @media (min-width: 1000px){
    .grade-portfolio{ grid-template-columns: repeat(3, 1fr); }
  }
</style>
</head>
<body>

  <header class="cabecalho">
    <div class="cabecalho-conteudo">
      <span class="logo">&lt;[SeuNome]/&gt;</span>
      <button class="botao-menu" id="btnMenu">☰</button>
      <nav class="menu-nav" id="menuNav">
        <a href="#sobre">Sobre</a>
        <a href="#portfolio">Portfólio</a>
        <a href="#skills">Skills</a>
        <a href="#social">Depoimentos</a>
        <a href="#contato">Contato</a>
      </nav>
    </div>
  </header>

  <section class="heroi" id="sobre">
    <div class="container">
      <img class="heroi-foto" src="foto.jpg" alt="Foto de [Seu Nome]">
      <h1 class="heroi-titulo">[Seu Nome]</h1>
      <p class="heroi-subtitulo">Desenvolvedora Back-end // Trainee</p>
      <p class="heroi-bio">
        Estou dando os primeiros passos como desenvolvedora back-end, estudando PHP, MySQL e lógica de programação, e construindo projetos como sistemas de cadastro e CRUD pra evoluir na área. Buscando minha primeira oportunidade como trainee.
      </p>
      <a href="#contato" class="botao-cta">Fale comigo</a>
    </div>
  </section>

  <section id="portfolio">
    <div class="container">
      <h2 class="titulo-secao">Portfólio</h2>
      <div class="grade-portfolio">
        <div class="cartao-projeto">
          <img src="projeto1.jpg" alt="Projeto 1">
          <div class="cartao-projeto-conteudo">
            <h3>[Nome do Projeto 1]</h3>
            <p>Breve descrição do projeto e as tecnologias usadas.</p>
            <a href="#">Ver projeto →</a>
          </div>
        </div>
        <div class="cartao-projeto">
          <img src="projeto2.jpg" alt="Projeto 2">
          <div class="cartao-projeto-conteudo">
            <h3>[Nome do Projeto 2]</h3>
            <p>Breve descrição do projeto e as tecnologias usadas.</p>
            <a href="#">Ver projeto →</a>
          </div>
        </div>
        <div class="cartao-projeto">
          <img src="projeto3.jpg" alt="Projeto 3">
          <div class="cartao-projeto-conteudo">
            <h3>[Nome do Projeto 3]</h3>
            <p>Breve descrição do projeto e as tecnologias usadas.</p>
            <a href="#">Ver projeto →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="skills">
    <div class="container">
      <h2 class="titulo-secao">Skills</h2>
      <div class="grade-skills">
        <div class="item-skill"><span>{ }</span><p>PHP</p></div>
        <div class="item-skill"><span>⛁</span><p>MySQL</p></div>
        <div class="item-skill"><span>⚙</span><p>Git</p></div>
        <div class="item-skill"><span>▲</span><p>Lógica de Programação</p></div>
      </div>
    </div>
  </section>

  <section id="social">
    <div class="container">
      <h2 class="titulo-secao">Prova Social</h2>
      <div class="grade-metricas">
        <div><div class="metrica-numero">[X]</div><div class="metrica-label">Projetos concluídos</div></div>
        <div><div class="metrica-numero">[X]</div><div class="metrica-label">Horas de estudo</div></div>
        <div><div class="metrica-numero">[X]</div><div class="metrica-label">Certificados</div></div>
        <div><div class="metrica-numero">[X]</div><div class="metrica-label">Meses estudando</div></div>
      </div>
      <div class="depoimento">
        "[Depoimento de um professor, colega ou cliente sobre seu trabalho.]" — [Nome]
      </div>
    </div>
  </section>

  <section id="contato">
    <div class="container">
      <h2 class="titulo-secao">Contato</h2>
      <form class="formulario-contato">
        <input type="text" placeholder="Seu nome" required>
        <input type="email" placeholder="Seu e-mail" required>
        <textarea rows="4" placeholder="Sua mensagem" required></textarea>
        <button type="submit">Enviar</button>
      </form>
      <div class="redes-sociais">
        <a href="#">LinkedIn</a>
        <a href="#">GitHub</a>
        <a href="#">E-mail</a>
      </div>
    </div>
  </section>

  <footer class="rodape">
    <p>&copy; 2026 [Seu Nome]. Todos os direitos reservados.</p>
  </footer>

  <script>
    document.getElementById('btnMenu').addEventListener('click', function(){
      document.getElementById('menuNav').classList.toggle('aberto');
    });
  </script>

</body>
</html>
