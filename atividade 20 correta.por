programa {
  funcao inicio() {
    inteiro numero 

    escreva("digite um numero de 1 a 4: ")
    leia(numero)

    se(numero == 1){
    escreva("dirija sua vida com coragem!")
    }

    senao se(numero == 2){
    escreva("pedale no seu ritmo!")
    }

    senao se(numero == 3){
    escreva("cada parada e so parte da viagem!")
    }

    senao se(numero == 4){
    escreva("cada passo tambem te leva ao destino!")
    }
  }
}
