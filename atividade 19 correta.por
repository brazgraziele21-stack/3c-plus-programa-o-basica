programa {
  funcao inicio() {
    inteiro dia 

    escreva("digite um numero de 1 a 7: ")
    leia(dia)

    se(dia == 1)
    escreva("sengunda-feira")

    senao se(dia == 2)
    escreva("terca-feira")

    senao se(dia == 3)
    escreva("quarta-feira")

    senao se(dia == 4)
    escreva("quinta-feira")

    senao se(dia == 5)
    escreva("sexta-feira")

    senao se(dia == 6)
    escreva("sabado")

    senao se(dia == 7)
    escreva("domingo")
  }
}
