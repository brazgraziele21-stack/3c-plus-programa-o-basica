programa {
  funcao inicio() {
    real num, num2

    escreva("digite o primeiro numero: ")
    leia(num)

    escreva("digite o segundo numero: ")
    leia(num2)

    se(num % num2 == 0)
    escreva("o primeiro numero e multiplo do segundo")

    senao 
    escreva("o primeiro nao numero e multiplo do segundo")
  }
}
